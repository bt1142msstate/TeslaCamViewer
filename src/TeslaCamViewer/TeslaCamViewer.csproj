<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TeslaCamViewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishProfile>Properties\PublishProfiles\win-x64.pubxml</PublishProfile>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Version>0.1.0-preview.5</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.5</FileVersion>
    <InformationalVersion>0.1.0-preview.5</InformationalVersion>
    <PackageVersion>0.1.0.5</PackageVersion>
    <Company>Brandon Temple</Company>
    <Authors>Brandon Temple</Authors>
    <Product>TESLA Cam</Product>
    <Description>Desktop TeslaCam viewer with stitched drive playback, telemetry HUD, markers, and export tools.</Description>
    <Copyright>Copyright (c) Brandon Temple</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/bt1142msstate/TeslaCamViewer</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ffmpeg\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\docs\legal\THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>THIRD-PARTY-NOTICES.txt</TargetPath>
    </Content>
  </ItemGroup>

  <Target Name="BuildCleanupHelper" BeforeTargets="Build">
    <MSBuild Projects="..\TeslaCamViewer.Cleanup\TeslaCamViewer.Cleanup.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);Platform=x64;RuntimeIdentifier=win-x64" />
  </Target>

  <Target Name="CopyCleanupHelper" AfterTargets="Build">
    <ItemGroup>
      <CleanupHelperFiles Include="..\TeslaCamViewer.Cleanup\bin\x64\$(Configuration)\net8.0\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(CleanupHelperFiles)"
          DestinationFiles="@(CleanupHelperFiles->'$(OutDir)Tools\cleanup\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
