<Window
    x:Class="TeslaCamViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="">

    <Grid Background="Transparent" RequestedTheme="Dark">
        <Grid.Resources>
            <Style x:Key="VideoCornerMaskPathStyle" TargetType="Path">
                <Setter Property="Fill" Value="{StaticResource VideoCornerMaskBrush}"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Stretch" Value="Fill"/>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <!-- Sidebar Width -->
            <ColumnDefinition x:Name="SidebarColumn" Width="320" MinWidth="300" MaxWidth="720"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="TitleBarDragRegion" Grid.ColumnSpan="2" Height="32" VerticalAlignment="Top" Background="Transparent" Margin="0,0,268,0" IsHitTestVisible="False"/>
        <Button x:Name="ChromeUpdateStatusButton"
                Grid.Column="1"
                Canvas.ZIndex="100"
                Width="30"
                Height="30"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                Margin="0,1,224,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{StaticResource GlassControlBrush}"
                BorderBrush="{StaticResource GlassBorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="15"
                Click="ChromeUpdateStatusButton_Click"
                ToolTipService.ToolTip="Update status">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#34FFFFFF"/>
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4AFFFFFF"/>
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#88FFFFFF"/>
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#B0FFFFFF"/>
            </Button.Resources>
            <Grid Width="18" Height="18">
                <ProgressRing x:Name="ChromeUpdateStatusRing"
                              Width="16"
                              Height="16"
                              IsActive="False"
                              Visibility="Collapsed"
                              Foreground="{StaticResource AccentCyanBrush}"/>
                <Path x:Name="ChromeUpdateCheckIcon"
                      Data="M7.1,13.4 L2.7,9 L4.1,7.6 L7.1,10.6 L13.9,3.8 L15.3,5.2 Z"
                      Fill="#FF56F39A"
                      Stretch="Uniform"
                      Width="16"
                      Height="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
                <Path x:Name="ChromeUpdateAvailableIcon"
                      Data="M8,1.5 A6.5,6.5 0 1 1 2.8,4.1 L1.3,4.1 L3.8,1.6 L6.3,4.1 L4.8,4.1 A4.8,4.8 0 1 0 8,3.2 Z M7.2,4.3 L8.8,4.3 L8.8,8.1 L10.6,6.3 L11.7,7.4 L8,11.1 L4.3,7.4 L5.4,6.3 L7.2,8.1 Z"
                      Fill="{StaticResource AccentCyanBrush}"
                      Stretch="Uniform"
                      Width="17"
                      Height="17"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"/>
            </Grid>
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="UpdateInfoFlyout"
                        Placement="BottomEdgeAlignedRight"
                        Opening="UpdateInfoFlyout_Opening">
                    <Border Width="440"
                            MaxHeight="620"
                            Background="{StaticResource GlassPanelBrush}"
                            BorderBrush="{StaticResource GlassBorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <ScrollViewer MaxHeight="580"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="UpdateInfoTitleText"
                                           Text="Update Status"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="UpdateInfoSummaryText"
                                           Text="Checking for updates..."
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="UPDATE FEATURES"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           CharacterSpacing="100"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="UpdateFeaturesText"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"/>
                                <TextBlock Text="CURRENT FEATURES"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           CharacterSpacing="100"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="CurrentFeaturesText"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="UpdateInfoCheckBtn"
                                            Content="Check again"
                                            Click="UpdateInfoCheckBtn_Click"
                                            Height="30"
                                            MinWidth="96"
                                            Padding="12,0"
                                            FontSize="11"
                                            Background="{StaticResource GlassControlBrush}"
                                            BorderBrush="{StaticResource GlassBorderSoftBrush}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            CornerRadius="15"/>
                                    <Button x:Name="UpdateInfoPrimaryBtn"
                                            Content="Update"
                                            Click="UpdateInfoPrimaryBtn_Click"
                                            Height="30"
                                            MinWidth="96"
                                            Padding="12,0"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Background="{StaticResource AccentCyanBrush}"
                                            Foreground="#FFFFFFFF"
                                            BorderThickness="0"
                                            CornerRadius="15"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
        </Button>

        <!-- ==========================================
             SIDEBAR BROWSER
             ========================================== -->
        <Border Grid.Column="0" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" Background="{StaticResource GlassSidebarBrush}" Padding="20" Margin="12" CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Logo -->
                    <RowDefinition Height="Auto"/> <!-- Dir Selector -->
                    <RowDefinition Height="Auto"/> <!-- Category Tabs -->
                    <RowDefinition Height="Auto"/> <!-- Search -->
                    <RowDefinition Height="Auto"/> <!-- Clip View Mode -->
                    <RowDefinition Height="Auto"/> <!-- App Status -->
                    <RowDefinition Height="*"/>    <!-- Clips List -->
                </Grid.RowDefinitions>

                <!-- Logo Section -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,24">
                    <Path Data="m545.8 845.8 71.9-404.6c68.6 0 90.2 7.5 93.3 38.2 0 0 46-17.2 69.2-52-90.5-41.9-181.5-43.8-181.5-43.8l-53.1 64.6h.1l-53.1-64.6s-91 1.9-181.5 43.8c23.2 34.8 69.2 52 69.2 52 3.1-30.7 24.7-38.2 92.8-38.3l72.7 404.7m0-480.9c73.2-.6 156.9 11.3 242.7 48.7 11.5-20.6 14.4-29.7 14.4-29.7-93.7-37.1-181.5-49.8-257.1-50.1-75.6.3-163.4 13-257.1 50.1 0 0 4.2 11.2 14.4 29.7 85.7-37.3 169.5-49.2 242.7-48.7"
                          Fill="{StaticResource AccentRedBrush}" Stretch="Uniform" Width="28" Height="28" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TESLA Cam" FontSize="16" FontWeight="Bold" CharacterSpacing="200" Foreground="{StaticResource SidebarTextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Directory Selection -->
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
                    <TextBlock Text="TESLACAM SOURCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SidebarTextMutedBrush}" CharacterSpacing="100"/>
                    <Border Height="28" Background="{StaticResource GlassSidebarInputBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DirTextBox"
                                     PlaceholderText="No TeslaCam source selected..."
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource SidebarTextPrimaryBrush}"
                                     PlaceholderForeground="{StaticResource SidebarTextMutedBrush}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Height="28"
                                     MinHeight="0"
                                     FontSize="11"
                                     CornerRadius="7,0,0,7"
                                     Padding="9,4,6,0"/>
                            <Border Grid.Column="1" Width="1" Margin="0,4,0,4" Background="{StaticResource GlassBorderSoftBrush}"/>
                            <Button Grid.Column="2"
                                    Background="Transparent"
                                    Foreground="{StaticResource SidebarTextPrimaryBrush}"
                                    BorderThickness="0"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="0,7,7,0"
                                    ToolTipService.ToolTip="Choose Source">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#24FFFFFF"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#34FFFFFF"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF"/>
                                </Button.Resources>
                                <Button.Flyout>
                                    <Flyout x:Name="SourceOptionsFlyout" Placement="RightEdgeAlignedTop">
                                        <Border Width="300" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="SELECT SOURCE" FontSize="10" FontWeight="Bold" CharacterSpacing="100" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="Open a TeslaCam storage folder or a compressed archive exported from the app." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                <Button Click="BrowseFolderSource_Click" HorizontalAlignment="Stretch" Background="{StaticResource GlassControlBrush}" BorderBrush="{StaticResource GlassBorderBrush}" CornerRadius="8" Padding="10,8,10,8">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="TeslaCam Folder" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="Use a mounted drive, SSD, SD card, or copied TeslaCam directory." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button Click="BrowseArchiveSource_Click" HorizontalAlignment="Stretch" Background="{StaticResource GlassControlBrush}" BorderBrush="{StaticResource GlassBorderBrush}" CornerRadius="8" Padding="10,8,10,8">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="Compressed File" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="Use a .zip archive, including all-views exports from this app." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{StaticResource SidebarTextPrimaryBrush}" Data="M3.75,6.5 C3.75,5.395 4.645,4.5 5.75,4.5 L9.1,4.5 C9.58,4.5 10.04,4.69 10.38,5.03 L11.85,6.5 L18.25,6.5 C19.355,6.5 20.25,7.395 20.25,8.5 L20.25,17.25 C20.25,18.355 19.355,19.25 18.25,19.25 L5.75,19.25 C4.645,19.25 3.75,18.355 3.75,17.25 Z M5.25,8.1 L5.25,17.25 C5.25,17.526 5.474,17.75 5.75,17.75 L18.25,17.75 C18.526,17.75 18.75,17.526 18.75,17.25 L18.75,8.5 C18.75,8.224 18.526,8 18.25,8 L11.54,8 C11.142,8 10.76,7.842 10.48,7.56 L9.32,6.4 C9.226,6.306 9.099,6.25 8.965,6.25 L5.75,6.25 C5.474,6.25 5.25,6.474 5.25,6.75 Z"/>
                                        <Path Fill="{StaticResource SidebarAccentBrush}" Opacity="0.9" Data="M6.5,10.25 C6.5,9.836 6.836,9.5 7.25,9.5 L16.75,9.5 C17.164,9.5 17.5,9.836 17.5,10.25 C17.5,10.664 17.164,11 16.75,11 L7.25,11 C6.836,11 6.5,10.664 6.5,10.25 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- Auto-detect button -->
                    <Button Content="AUTO-DETECT DRIVE" Click="AutoDetectButton_Click" FontSize="10" FontWeight="Bold" HorizontalAlignment="Stretch" Background="{StaticResource GlassSidebarInputBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" Foreground="{StaticResource SidebarAccentBrush}" Margin="0,4,0,0" CornerRadius="8"/>
                </StackPanel>

                <!-- Categories -->
                <Border Grid.Row="2" Background="{StaticResource GlassSidebarInputBrush}" Padding="4" CornerRadius="8" Margin="0,0,0,12" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="TabRecent" Grid.Column="0" Content="RECENT" IsChecked="True" Checked="Tab_Checked" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SidebarTextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ToggleButton x:Name="TabSaved" Grid.Column="1" Content="SAVED" Checked="Tab_Checked" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SidebarTextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ToggleButton x:Name="TabSentry" Grid.Column="2" Content="SENTRY" Checked="Tab_Checked" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SidebarTextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- Search box -->
                <TextBox x:Name="SearchBox" Grid.Row="3" PlaceholderText="Search clips..." TextChanged="SearchBox_TextChanged" Background="{StaticResource GlassSidebarInputBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" Foreground="{StaticResource SidebarTextPrimaryBrush}" PlaceholderForeground="{StaticResource SidebarTextMutedBrush}" Margin="0,0,0,10" CornerRadius="8"/>

                <!-- Clip view mode -->
                <Border Grid.Row="4" Background="{StaticResource GlassSidebarInputBrush}" Padding="4" CornerRadius="8" Margin="0,0,0,12" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="ClipListModeButton" Grid.Column="0" Content="LIST" IsChecked="True" Checked="ClipViewMode_Checked" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SidebarTextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ToggleButton x:Name="ClipCollageModeButton" Grid.Column="1" Content="COLLAGE" Checked="ClipViewMode_Checked" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SidebarTextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- App status -->
                <Border x:Name="AppStatusHost" Grid.Row="5" Background="{StaticResource GlassSidebarInputBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6,8,6" Margin="0,0,0,10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="AppStatusProgressRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" Foreground="{StaticResource SidebarAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AppStatusText" Grid.Column="1" Text="Ready" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SidebarTextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button x:Name="AppUpdateBtn"
                                Grid.Column="2"
                                Content="Update"
                                Click="AppUpdateBtn_Click"
                                Visibility="Collapsed"
                                IsEnabled="False"
                                Height="22"
                                MinWidth="54"
                                Padding="10,0,10,0"
                                FontSize="10"
                                FontWeight="Bold"
                                Background="{StaticResource GlassControlBrush}"
                                BorderBrush="{StaticResource GlassBorderSoftBrush}"
                                Foreground="{StaticResource SidebarTextPrimaryBrush}"
                                CornerRadius="11"
                                ToolTipService.ToolTip="Install the latest GitHub release">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#34FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4AFFFFFF"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#88FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#B0FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF"/>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Clips list -->
                <Grid Grid.Row="6">
                    <ListView x:Name="ClipsListView"
                              SelectionChanged="ClipsListView_SelectionChanged"
                              ContainerContentChanging="ClipsListView_ContainerContentChanging"
                              Background="Transparent"
                              Padding="0"
                              SelectionMode="Single"
                              ShowsScrollingPlaceholders="True"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#24FFFFFF"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#34FFFFFF"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#365AC8FA"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#4A5AC8FA"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#625AC8FA"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="#225AC8FA"/>
                            <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#FFFFFFFF"/>
                            <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">True</x:Boolean>
                            <CornerRadius x:Key="ListViewItemCornerRadius">10</CornerRadius>
                            <CornerRadius x:Key="ListViewItemSelectionIndicatorCornerRadius">2</CornerRadius>
                        </ListView.Resources>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource GlassSidebarCardBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10,12,10" Margin="0,4,0,4" HorizontalAlignment="Stretch">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SidebarTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Background="{StaticResource GlassSidebarInputBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="7,3,7,3" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding DurationText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SidebarAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding TimeRangeText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SidebarTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                            <Border Background="{StaticResource GlassSidebarInputBrush}" CornerRadius="6" Padding="6,3,6,3">
                                                <TextBlock Text="{Binding SegmentCountText}" FontSize="9" Foreground="{StaticResource SidebarTextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{StaticResource GlassSidebarInputBrush}" CornerRadius="6" Padding="6,3,6,3">
                                                <TextBlock Text="{Binding CameraCountText}" FontSize="9" Foreground="{StaticResource SidebarTextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{StaticResource GlassSidebarInputBrush}" CornerRadius="6" Padding="6,3,6,3" MaxWidth="92">
                                                <TextBlock Text="{Binding ClipTypeText}" FontSize="9" Foreground="{StaticResource SidebarAccentBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                                            <Border Background="{StaticResource GlassSidebarInputBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="7,3,7,3">
                                                <TextBlock Text="{Binding FsdPercentText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                            </Border>
                                            <Border Background="{StaticResource GlassSidebarInputBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="7,3,7,3">
                                                <TextBlock Text="{Binding DisengagementCountText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <GridView x:Name="ClipsCollageView"
                              SelectionChanged="ClipsListView_SelectionChanged"
                              ContainerContentChanging="ClipsListView_ContainerContentChanging"
                              Visibility="Collapsed"
                              Background="Transparent"
                              Padding="0"
                              SelectionMode="Single"
                              ShowsScrollingPlaceholders="True"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <GridView.Resources>
                            <SolidColorBrush x:Key="GridViewItemBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#24FFFFFF"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="#34FFFFFF"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#365AC8FA"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#4A5AC8FA"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#625AC8FA"/>
                            <SolidColorBrush x:Key="GridViewItemForegroundPointerOver" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="GridViewItemForegroundSelected" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="GridViewItemSelectionIndicatorBrush" Color="#FFFFFFFF"/>
                            <x:Boolean x:Key="GridViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                            <x:Boolean x:Key="GridViewItemSelectionIndicatorVisualEnabled">True</x:Boolean>
                            <CornerRadius x:Key="GridViewItemCornerRadius">10</CornerRadius>
                        </GridView.Resources>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="128" ItemHeight="166"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2,2,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="122" Height="160" Background="{StaticResource GlassSidebarCardBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="9" Padding="6" HorizontalAlignment="Center">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="66"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource GlassSidebarInputBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Grid>
                                                <TextBlock Text="Preview" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SidebarTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding DateText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SidebarTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeRangeText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SidebarTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SidebarAccentBrush}" Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Grid.Row="3" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource GlassSidebarInputBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="5,2,5,2">
                                                <TextBlock Text="{Binding FsdPercentText}" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource GlassSidebarInputBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="5,2,5,2" MinWidth="0">
                                                <TextBlock Text="{Binding DisengagementCountText}" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <TextBlock x:Name="EmptyStateText" Text="No clips loaded. Select a path and click SCAN." Foreground="{StaticResource SidebarTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="10"/>
                    <ProgressRing x:Name="ScanProgressRing" IsActive="False" Width="30" Height="30" Foreground="{StaticResource SidebarAccentBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="SidebarResizeEdge"
                Grid.Column="0"
                Canvas.ZIndex="20"
                Width="18"
                Margin="0,18,0,18"
                HorizontalAlignment="Right"
                Background="Transparent"
                PointerEntered="SidebarResizeHandle_PointerEntered"
                PointerExited="SidebarResizeHandle_PointerExited"
                PointerPressed="SidebarResizeHandle_PointerPressed"
                PointerMoved="SidebarResizeHandle_PointerMoved"
                PointerReleased="SidebarResizeHandle_PointerReleased"
                PointerCanceled="SidebarResizeHandle_PointerCanceled"
                ToolTipService.ToolTip="Drag sidebar edge to resize">
            <Border x:Name="SidebarResizeHighlight"
                    Width="4"
                    Margin="0,10,12,10"
                    HorizontalAlignment="Right"
                    CornerRadius="2"
                    Background="{StaticResource SidebarAccentBrush}"
                    Opacity="0"/>
        </Border>

        <!-- ==========================================
             MAIN CONTENT VIEWPORT & HUD
             ========================================== -->
        <Border Grid.Column="1" Padding="24" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Multi-Video Grid -->
                    <RowDefinition Height="Auto"/> <!-- Controls -->
                    <RowDefinition Height="Auto"/> <!-- HUD Dashboard -->
                </Grid.RowDefinitions>

            <!-- Workspace Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ActiveClipTitle" Text="No Clip Loaded" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ActiveClipSubtitle" Text="Select a drive from the sidebar to begin" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="SharedStatusPill" Visibility="Collapsed" Background="{StaticResource GlassPanelBrush}" CornerRadius="14" Padding="10,6,12,6" BorderThickness="1" BorderBrush="{StaticResource GlassBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing x:Name="SharedStatusRing" IsActive="False" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock x:Name="SharedStatusText" Text="Loading" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AutonomyBadge" Visibility="Collapsed" Background="{StaticResource GlassPanelBrush}" CornerRadius="12" Padding="12,6,12,6" BorderThickness="1" BorderBrush="{StaticResource GlassBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="BadgeDot" Width="6" Height="6" Fill="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="BadgeText" Text="STATE: PARKED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Video Player Grid -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Large Main Player -->
                <Border x:Name="CardFront" Grid.Column="0" CornerRadius="18" Background="{StaticResource GlassDarkBrush}" BorderThickness="0" Padding="0" Margin="0,0,16,0">
                    <Grid>
                        <MediaPlayerElement x:Name="MainPlayer" CornerRadius="16"/>
                        <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 A1,1 0 0 0 0,1 V0 Z" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 V1 A1,1 0 0 0 0,0 Z" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 A1,1 0 0 0 1,1 H0 Z" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M1,0 V1 H0 A1,1 0 0 0 1,0 Z" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <Border Background="{StaticResource GlassLabelBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4,6,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" IsHitTestVisible="False">
                            <TextBlock x:Name="MainAngleLabel" Text="FRONT CAMERA" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                        <Border x:Name="VideoLoadingOverlay" Visibility="Collapsed" Background="#7A000000" CornerRadius="16" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <Border Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16,12,18,12">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <ProgressRing x:Name="VideoLoadingRing" IsActive="False" Width="24" Height="24" Foreground="{StaticResource AccentCyanBrush}"/>
                                        <TextBlock x:Name="VideoLoadingText" Text="Loading video" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 5 Auxiliary Players Grid Layout (Physical Geometry) -->
                <Grid Grid.Column="1" Margin="0,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left/Right Repeaters (Row 0) -->
                    <Border x:Name="CardLeftRepeater" Grid.Row="0" Grid.Column="0" CornerRadius="14" Background="{StaticResource GlassDarkBrush}" BorderThickness="0" Padding="0" PointerPressed="AuxCard_PointerPressed" Tag="left_repeater" Margin="0,0,4,4">
                        <Grid>
                            <MediaPlayerElement x:Name="PlayerLeftRepeater" CornerRadius="12"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 A1,1 0 0 0 0,1 V0 Z" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 V1 A1,1 0 0 0 0,0 Z" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 A1,1 0 0 0 1,1 H0 Z" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M1,0 V1 H0 A1,1 0 0 0 1,0 Z" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <Border Background="{StaticResource GlassLabelBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                <TextBlock Text="L REPEATER (FENDER)" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="CardRightRepeater" Grid.Row="0" Grid.Column="1" CornerRadius="14" Background="{StaticResource GlassDarkBrush}" BorderThickness="0" Padding="0" PointerPressed="AuxCard_PointerPressed" Tag="right_repeater" Margin="4,0,0,4">
                        <Grid>
                            <MediaPlayerElement x:Name="PlayerRightRepeater" CornerRadius="12"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 A1,1 0 0 0 0,1 V0 Z" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 V1 A1,1 0 0 0 0,0 Z" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 A1,1 0 0 0 1,1 H0 Z" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M1,0 V1 H0 A1,1 0 0 0 1,0 Z" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <Border Background="{StaticResource GlassLabelBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                <TextBlock Text="R REPEATER (FENDER)" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Left/Right Pillars (Row 1) -->
                    <Border x:Name="CardLeftPillar" Grid.Row="1" Grid.Column="0" CornerRadius="14" Background="{StaticResource GlassDarkBrush}" BorderThickness="0" Padding="0" PointerPressed="AuxCard_PointerPressed" Tag="left_pillar" Margin="0,4,4,4">
                        <Grid>
                            <MediaPlayerElement x:Name="PlayerLeftPillar" CornerRadius="12"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 A1,1 0 0 0 0,1 V0 Z" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 V1 A1,1 0 0 0 0,0 Z" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 A1,1 0 0 0 1,1 H0 Z" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M1,0 V1 H0 A1,1 0 0 0 1,0 Z" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <Border Background="{StaticResource GlassLabelBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                <TextBlock Text="L PILLAR (B-PILLAR)" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="CardRightPillar" Grid.Row="1" Grid.Column="1" CornerRadius="14" Background="{StaticResource GlassDarkBrush}" BorderThickness="0" Padding="0" PointerPressed="AuxCard_PointerPressed" Tag="right_pillar" Margin="4,4,0,4">
                        <Grid>
                            <MediaPlayerElement x:Name="PlayerRightPillar" CornerRadius="12"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 A1,1 0 0 0 0,1 V0 Z" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 V1 A1,1 0 0 0 0,0 Z" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 A1,1 0 0 0 1,1 H0 Z" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M1,0 V1 H0 A1,1 0 0 0 1,0 Z" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <Border Background="{StaticResource GlassLabelBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                <TextBlock Text="R PILLAR (B-PILLAR)" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Rear View (Row 2, Centered / Spans both columns) -->
                    <Border x:Name="CardBack" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="14" Background="{StaticResource GlassDarkBrush}" BorderThickness="0" Padding="0" PointerPressed="AuxCard_PointerPressed" Tag="back" Margin="0,4,0,0">
                        <Grid>
                            <MediaPlayerElement x:Name="PlayerBack" CornerRadius="12"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 A1,1 0 0 0 0,1 V0 Z" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 H1 V1 A1,1 0 0 0 0,0 Z" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M0,0 A1,1 0 0 0 1,1 H0 Z" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Path Style="{StaticResource VideoCornerMaskPathStyle}" Data="M1,0 V1 H0 A1,1 0 0 0 1,0 Z" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <Border Background="{StaticResource GlassLabelBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                <TextBlock Text="REAR VIEW" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Sync Controls -->
            <Border Grid.Row="2" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8,12,8" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Play Button -->
                        <ColumnDefinition Width="Auto"/> <!-- Time current -->
                        <ColumnDefinition Width="*"/>    <!-- Seek slider -->
                        <ColumnDefinition Width="Auto"/> <!-- Time duration -->
                        <ColumnDefinition Width="Auto"/> <!-- Speed Selector -->
                        <ColumnDefinition Width="Auto"/> <!-- Marker range -->
                        <ColumnDefinition Width="Auto"/> <!-- In marker -->
                        <ColumnDefinition Width="Auto"/> <!-- Out marker -->
                        <ColumnDefinition Width="Auto"/> <!-- Clear markers -->
                        <ColumnDefinition Width="Auto"/> <!-- Export -->
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayPauseBtn" Grid.Column="0" Click="PlayPauseBtn_Click" IsEnabled="False" Width="36" Height="36" CornerRadius="18" Background="{StaticResource GlassControlBrush}" BorderBrush="{StaticResource GlassBorderBrush}" Margin="0,0,12,0">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </Button>
                    <TextBlock x:Name="TimeCurrentText" Grid.Column="1" Text="00:00" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Grid x:Name="TimelineScrubberHost"
                          Grid.Column="2"
                          Height="32"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          IsHitTestVisible="False"
                          Opacity="0.55"
                          PointerPressed="TimelineScrubber_PointerPressed"
                          PointerMoved="TimelineScrubber_PointerMoved"
                          PointerReleased="TimelineScrubber_PointerReleased"
                          PointerCanceled="TimelineScrubber_PointerCanceled"
                          PointerCaptureLost="TimelineScrubber_PointerCanceled">
                        <Slider x:Name="TimelineSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                StepFrequency="0.1"
                                IsEnabled="False"
                                ValueChanged="TimelineSlider_ValueChanged"
                                Visibility="Collapsed"/>

                        <Grid x:Name="TimelineTrack" Height="12" Margin="22,0" VerticalAlignment="Center">
                            <Border CornerRadius="6" Background="#22FFFFFF" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1"/>
                            <Border x:Name="ExportRangeHighlight" Width="0" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="9" Background="#4430D158" BorderBrush="#6630D158" BorderThickness="1" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ExportRangeHighlightTransform"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="TimelineProgress" Width="0" HorizontalAlignment="Left" CornerRadius="6" Background="#A85AC8FA"/>
                            <Border CornerRadius="6" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0"/>
                        </Grid>
                        <Canvas x:Name="TimelineDisengagementMarkersCanvas"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"/>
                        <Border x:Name="ExportStartMarker" Width="4" Height="24" CornerRadius="2" Background="#30D158" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ExportStartMarkerTransform"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="ExportEndMarker" Width="4" Height="24" CornerRadius="2" Background="#FF453A" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ExportEndMarkerTransform"/>
                            </Border.RenderTransform>
                        </Border>

                        <Border x:Name="TimelineGlassThumb"
                                Width="34"
                                Height="16"
                                CornerRadius="8"
                                Background="{StaticResource LiquidThumbGlassBrush}"
                                BorderBrush="{StaticResource LiquidThumbRimBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TimelineGlassThumbTransform"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="TimeDurationText" Grid.Column="3" Text="00:00" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,12,0"/>
                    <ComboBox x:Name="SpeedComboBox" Grid.Column="4" IsEnabled="False" SelectionChanged="SpeedComboBox_SelectionChanged" Background="{StaticResource GlassControlBrush}" BorderBrush="{StaticResource GlassBorderBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Width="80" CornerRadius="8">
                        <ComboBoxItem Content="0.25x" Tag="0.25"/>
                        <ComboBoxItem Content="0.5x" Tag="0.5"/>
                        <ComboBoxItem Content="1.0x" Tag="1.0" IsSelected="True"/>
                        <ComboBoxItem Content="1.5x" Tag="1.5"/>
                        <ComboBoxItem Content="2.0x" Tag="2.0"/>
                    </ComboBox>
                    <TextBlock x:Name="ExportMarkerText" Grid.Column="5" Text="Range --:-- - --:--" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <Button x:Name="MarkStartBtn" Grid.Column="6" Click="MarkStartBtn_Click" IsEnabled="False" Content="IN" Width="42" Height="32" CornerRadius="8" Background="{StaticResource GlassControlBrush}" BorderBrush="{StaticResource GlassBorderBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10" FontWeight="Bold" ToolTipService.ToolTip="Set export start marker"/>
                    <Button x:Name="MarkEndBtn" Grid.Column="7" Click="MarkEndBtn_Click" IsEnabled="False" Content="OUT" Width="48" Height="32" CornerRadius="8" Background="{StaticResource GlassControlBrush}" BorderBrush="{StaticResource GlassBorderBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10" FontWeight="Bold" Margin="6,0,0,0" ToolTipService.ToolTip="Set export end marker"/>
                    <Button x:Name="ClearMarkersBtn" Grid.Column="8" Click="ClearMarkersBtn_Click" IsEnabled="False" Width="34" Height="32" CornerRadius="8" Background="{StaticResource GlassControlBrush}" BorderBrush="{StaticResource GlassBorderBrush}" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,0,0,0" ToolTipService.ToolTip="Clear export markers">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE894;" FontSize="11"/>
                    </Button>
                    <Button x:Name="ExportRangeBtn" Grid.Column="9" Click="ExportRangeBtn_Click" IsEnabled="False" Height="32" CornerRadius="8" Background="{StaticResource AccentCyanStrongBrush}" BorderBrush="{StaticResource GlassBorderBrush}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Padding="10,0,10,0" Margin="6,0,0,0" ToolTipService.ToolTip="Export marked range">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="ExportOptionsFlyout" Placement="TopEdgeAlignedRight">
                                <Border Width="320" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="EXPORT RANGE" FontSize="10" FontWeight="Bold" CharacterSpacing="100" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="Choose what to save from the marked IN/OUT range." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <Button Click="ExportCurrentViewMenuItem_Click" HorizontalAlignment="Stretch" Background="{StaticResource GlassControlBrush}" BorderBrush="{StaticResource GlassBorderBrush}" CornerRadius="8" Padding="10,8,10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B2;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,10,0"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="Current View" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Exports the camera currently in the main viewport as one MP4." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Click="ExportAllViewsMenuItem_Click" HorizontalAlignment="Stretch" Background="{StaticResource GlassControlBrush}" BorderBrush="{StaticResource GlassBorderBrush}" CornerRadius="8" Padding="10,8,10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,10,0"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="All Views" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Exports every available camera as separate MP4 files in a compressed folder." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE896;" FontSize="11"/>
                            <TextBlock Text="EXPORT"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Dashboard Telemetry HUD -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Speedometer -->
                <Border Grid.Column="0" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,0" Height="140">
                    <Grid>
                        <TextBlock Text="VEHICLE SPEED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock x:Name="HudSpeed" Text="00" FontSize="36" FontWeight="ExtraBold" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="MPH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Autopilot Wheel -->
                <Border Grid.Column="1" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="8,0,8,0" Height="140">
                    <Grid>
                        <TextBlock Text="DRIVE STATE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                            <!-- Native steering wheel shape representation -->
                            <Grid Width="50" Height="50" x:Name="SteeringWheelGrid" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="0" x:Name="SteerRotateTransform"/>
                                </Grid.RenderTransform>
                                <Ellipse Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="4" Width="46" Height="46"/>
                                <Line X1="25" Y1="2" X2="25" Y2="25" Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="10" Y1="34" X2="25" Y2="25" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="40" Y1="34" X2="25" Y2="25" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse Fill="{StaticResource GlassControlBrush}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" Width="14" Height="14"/>
                            </Grid>
                            <TextBlock x:Name="HudApText" Text="PARKED" FontSize="9" FontWeight="Black" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pedals -->
                <Border Grid.Column="2" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="8,0,8,0" Height="140">
                    <Grid>
                        <TextBlock Text="PEDAL TELEMETRY" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Accel -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="ACCEL" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <Grid Height="60" Width="10" Background="{StaticResource GlassRailBrush}" CornerRadius="2">
                                    <Border x:Name="AccelBar" VerticalAlignment="Bottom" Height="0" Width="10" CornerRadius="2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                <GradientStop Color="#30D158" Offset="0.0"/>
                                                <GradientStop Color="#5AC8FA" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="HudAccelText" Text="0%" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Brake -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="BRAKE" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <Grid Height="60" Width="10" Background="{StaticResource GlassRailBrush}" CornerRadius="2">
                                    <Border x:Name="BrakeBar" VerticalAlignment="Bottom" Height="0" Width="10" Background="{StaticResource AccentRedBrush}" CornerRadius="2"/>
                                </Grid>
                                <TextBlock x:Name="HudBrakeText" Text="OFF" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Steering degrees -->
                <Border Grid.Column="3" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="8,0,8,0" Height="140">
                    <Grid>
                        <TextBlock Text="STEERING WHEEL" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <TextBlock x:Name="HudSteerAngleText" Text="STRAIGHT 0.0&#x00B0;" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <Grid Width="100" Height="10" Background="{StaticResource GlassRailBrush}" CornerRadius="5" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
                                <Line X1="50" Y1="0" X2="50" Y2="10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1"/>
                                <Canvas>
                                    <Border x:Name="SteerVisualPointer" Width="8" Height="14" CornerRadius="4" Background="{StaticResource AccentCyanBrush}" Canvas.Left="46" Canvas.Top="-3"/>
                                </Canvas>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamics (Blinkers/G) -->
                <Border Grid.Column="4" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="8,0,8,0" Height="140">
                    <Grid>
                        <TextBlock Text="BLINKERS / G" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel Spacing="10" Margin="0,16,0,0">
                            <!-- Blinkers & Gear -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BlinkerLeftText" Grid.Column="0" Text="◀" FontSize="18" Foreground="#38FFFFFF"/>
                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Background="{StaticResource GlassControlBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="HudGearText" Text="P" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="BlinkerRightText" Grid.Column="2" Text="▶" FontSize="18" Foreground="#38FFFFFF"/>
                            </Grid>
                            
                            <!-- G-force Coordinates -->
                             <Border BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="Auto"/>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="Auto"/>
                                     </Grid.ColumnDefinitions>
                                <TextBlock Text="G-FORCE:" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{StaticResource GlassRailBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                    <!-- Axes -->
                                    <Line X1="18" Y1="0" X2="18" Y2="36" Stroke="#22FFFFFF" StrokeThickness="1"/>
                                    <Line X1="0" Y1="18" X2="36" Y2="18" Stroke="#22FFFFFF" StrokeThickness="1"/>
                                    <Canvas>
                                        <Ellipse x:Name="GDot" Width="6" Height="6" Fill="{StaticResource AccentCyanBrush}" Canvas.Left="15" Canvas.Top="15"/>
                                    </Canvas>
                                </Grid>
                                <TextBlock x:Name="HudGForceText" Grid.Column="2" Text="0.00 G" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPS Coordinates -->
                <Border Grid.Column="5" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="8,0,0,0" Height="140">
                    <Grid>
                        <TextBlock Text="GPS TELEMETRY" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,12,0,0">
                            <Grid>
                                <TextBlock Text="LAT: " FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="HudLat" Text="0.000000°" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="LON: " FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="HudLon" Text="0.000000°" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="HDG: " FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="HudHeading" Text="0.0° N" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Grid>
</Window>
